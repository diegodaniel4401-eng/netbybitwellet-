# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SENDER_EMAIL: Official sender address for automated platform emails.
SENDER_EMAIL="netbybitsupport@gmail.com"

# ADMIN_NOTIFICATION_EMAIL: Recipient address for administrative alerts (new user, withdrawal request, support ticket, wallet connect).
ADMIN_NOTIFICATION_EMAIL="netbybitsupport@gmail.com"

# Optional SMTP Configuration for live email transport
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
